{
  // markdownlint-cli2 options, and the markdownlint rules under "config".
  //
  // Lint every Markdown file that git does not ignore, so a local run and the
  // CI run read the same files.
  "globs": ["**/*.md"],
  "gitignore": true,
  "config": {
    "MD013": false,
    "MD024": {
      "siblings_only": true
    }
  }
}
