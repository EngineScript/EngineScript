{
  // markdownlint rules: every default rule, with these changes. markdownlint-cli2 (npm run lint:md)
  // reads this file, and Codacy's markdownlint uses it when its "Configuration file" setting is on.

  // Long lines are allowed: prose is wrapped where it reads best, and tables and URLs cannot wrap.
  "MD013": false,

  // A heading may repeat under different parents, such as the changelog's sections under each date.
  "MD024": {
    "siblings_only": true
  }
}
