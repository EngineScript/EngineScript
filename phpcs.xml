<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="EngineScript Admin Control Panel Coding Standards">
    <description>Coding standards for the admin control panel and the admin tools' configuration: PSR-12, read against the current PER Coding Style, with the plugin repositories' general standards.</description>

    <!--
        Codacy reads this file (its PHP_CodeSniffer "Configuration file" setting), so it may use only
        the standards Codacy installs: PHP_CodeSniffer's own, Slevomat, VariableAnalysis, and
        PHPCompatibility. The PHPCSExtra sniffs (Universal, Modernize, NormalizedArrays), which Codacy
        does not install, are in phpcs-extra.xml; it includes this file, and composer and CI run it.
    -->

    <!-- Files to check: the panel and the tools' EngineScript configuration -->
    <file>config/var/www/admin</file>
    <file>rector.php</file>
    <file>.php-cs-fixer.dist.php</file>

    <!-- Exclude patterns -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/.private/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>

    <!--
        PSR-12 is the closest standard PHPCS ships to the PER Coding Style, which supersedes it.
        Where a PSR-12 sniff disagrees with PER, PER wins: the sniff is excluded here with the
        reason, and PHP-CS-Fixer's @PER-CS set (.php-cs-fixer.dist.php) checks the PER rule.
    -->
    <rule ref="PSR12"/>

    <!-- Every EngineScript repository writes arrays one way: the short syntax. -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

    <!-- Unused and undefined variables (the plugin repositories get this through WordPress-VIP-Go). -->
    <rule ref="VariableAnalysis"/>

    <!-- Checks that Codacy's EngineScript Main standard also runs, so CI reports them first. -->
    <!-- Code that runs shell commands or arbitrary PHP: the panel runs commands only through SystemCommand. -->
    <rule ref="Generic.PHP.BacktickOperator"/>
    <rule ref="Squiz.PHP.Eval"/>
    <!-- Functions PHP has deprecated, and $_REQUEST, which mixes query, form, and cookie values. -->
    <rule ref="Generic.PHP.DeprecatedFunctions"/>
    <rule ref="Generic.PHP.DisallowRequestSuperglobal"/>
    <!-- Mistakes: leftover merge markers, a function call in a for loop's test, an executable PHP file,
         an empty catch block without a comment saying why, and a PHP 4 style constructor. -->
    <rule ref="Generic.VersionControl.GitMergeConflict"/>
    <rule ref="Generic.CodeAnalysis.ForLoopWithTestFunctionCall"/>
    <rule ref="Generic.Files.ExecutableFile"/>
    <rule ref="Squiz.Commenting.EmptyCatchComment"/>
    <rule ref="Generic.NamingConventions.ConstructorName"/>
    <!-- Concatenating two literals on one line; a long string split over lines stays allowed. -->
    <rule ref="Generic.Strings.UnnecessaryStringConcat">
        <properties>
            <property name="allowMultiline" value="true"/>
        </properties>
    </rule>
    <!-- Leftover TODO comments, Yoda conditions, php_sapi_name() instead of PHP_SAPI, and count()
         or strlen() in a loop condition. -->
    <rule ref="Generic.Commenting.Todo"/>
    <rule ref="Generic.ControlStructures.DisallowYodaConditions"/>
    <rule ref="Generic.PHP.SAPIUsage"/>
    <rule ref="Squiz.PHP.DisallowSizeFunctionsInLoops"/>
    <!-- Layout PSR-12 leaves open: one space after a cast (as @PER-CS has it), include and require
         written as statements, multi-line assignments and chained calls indented by four spaces,
         no spaces inside array brackets, and aligned doc comment asterisks. -->
    <rule ref="Generic.Formatting.SpaceAfterCast"/>
    <rule ref="PEAR.Files.IncludingFile"/>
    <rule ref="PEAR.Formatting.MultiLineAssignment"/>
    <rule ref="PEAR.WhiteSpace.ObjectOperatorIndent"/>
    <rule ref="Squiz.Arrays.ArrayBracketSpacing"/>
    <rule ref="Squiz.Commenting.DocCommentAlignment"/>

    <!-- Slevomat checks Codacy runs: arrow functions written "fn($x) => ...", closures that could be
         static, unused parameters, variables and imports, sorted imports, loose == and != comparisons,
         a variable assigned only to be returned, and unpacking that stops PHP optimizing a call. -->
    <rule ref="SlevomatCodingStandard.Functions.ArrowFunctionDeclaration">
        <properties>
            <property name="spacesCountAfterKeyword" value="0"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Functions.StaticClosure"/>
    <rule ref="SlevomatCodingStandard.Functions.UnusedParameter"/>
    <rule ref="SlevomatCodingStandard.Namespaces.AlphabeticallySortedUses">
        <properties>
            <property name="psr12Compatible" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses"/>
    <rule ref="SlevomatCodingStandard.Operators.DisallowEqualOperators"/>
    <rule ref="SlevomatCodingStandard.PHP.OptimizedFunctionsWithoutUnpacking"/>
    <rule ref="SlevomatCodingStandard.Variables.UnusedVariable"/>
    <rule ref="SlevomatCodingStandard.Variables.UselessVariable"/>

    <!-- PHP version compatibility, from the panel's minimum version up. -->
    <rule ref="PHPCompatibility">
        <include-pattern>*\.php$</include-pattern>
    </rule>
    <config name="testVersion" value="8.3-"/>

    <!-- File formatting -->
    <rule ref="Generic.Files.ByteOrderMark"/>
    <rule ref="Generic.Files.LineEndings">
        <properties>
            <property name="eolChar" value="\n"/>
        </properties>
    </rule>

    <!-- Report every message, including those that a standard rates below the default severity of 5. -->
    <arg name="severity" value="1"/>

    <!-- Show progress -->
    <arg value="p"/>

    <!-- Show sniff codes in all reports -->
    <arg value="s"/>

    <!-- Use colors in output -->
    <arg name="colors"/>

</ruleset>
