# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Custom for Visual Studio
*.cs     diff=csharp

# Standard to msysgit
*.doc	 diff=astextplain
*.DOC	 diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.dot  diff=astextplain
*.DOT  diff=astextplain
*.pdf  diff=astextplain
*.PDF	 diff=astextplain
*.rtf	 diff=astextplain
*.RTF	 diff=astextplain

# Exclude development tooling from git archive and GitHub source archives.
# The product's documentation (README.md, CHANGELOG.md, SECURITY.md, docs/)
# stays in them. Directories are named themselves, not as dir/**.
/.github export-ignore
/.codacy.yml export-ignore
/.config export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.htmlvalidate.json export-ignore
/.markdownlint-cli2.jsonc export-ignore
/.mypy.ini export-ignore
/.php-cs-fixer.dist.php export-ignore
/.ruff.toml export-ignore
/.stylelintrc.json export-ignore
/.yamllint.yml export-ignore
/composer.json export-ignore
/eslint.config.mjs export-ignore
/package.json export-ignore
/phpcs.xml export-ignore
/phpmd.xml export-ignore
/phpstan.neon export-ignore
/phpunit.xml export-ignore
/psalm.xml export-ignore
/rector.php export-ignore
/tests export-ignore
/tslint.json export-ignore
