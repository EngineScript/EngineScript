<?xml version="1.0" encoding="UTF-8"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    phpVersion="8.3"
    findUnusedCode="true"
    findUnusedIssueHandlerSuppression="false"
>
    <projectFiles>
        <directory name="config/var/www/admin" />
    </projectFiles>

    <issueHandlers>
        <!--
            TinyFileManager includes this file and reads the variables it sets, so they are
            used, but not in a file Psalm sees. The one suppression in this configuration (D-025).
            Taint analysis does not look for unused variables, so findUnusedIssueHandlerSuppression
            is off: otherwise that run reports this handler as unused.
        -->
        <UnusedVariable>
            <errorLevel type="suppress">
                <file name="config/var/www/admin/tools/tinyfilemanager/config.php" />
            </errorLevel>
        </UnusedVariable>
    </issueHandlers>
</psalm>
